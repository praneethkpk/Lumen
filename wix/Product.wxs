<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    Lumen per-user MSI package.
    Build with -dAppImageDir=<absolute-or-project-relative-path-to-dist/Lumen>
    Keep UpgradeCode stable across all Lumen releases.
  -->

  <Package
      Name="Lumen"
      Manufacturer="Praneeth Kumar"
      Version="$(var.ProductVersion)"
      UpgradeCode="8D51B2C4-7D8A-4D7D-9C1B-4E2F0A7B61D3"
      Scope="perUser"
      InstallerVersion="500"
      Compressed="yes">

    <SummaryInformation Description="Lumen — universal search for Windows" />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of Lumen is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Install to %LOCALAPPDATA%\Programs\Lumen; no elevation required. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Lumen" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="Lumen" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Lumen" Level="1">
      <ComponentGroupRef Id="AppImageFiles" />
      <ComponentRef Id="ApplicationShortcuts" />
      <ComponentRef Id="InstallFolderCleanup" />
    </Feature>

  </Package>

  <Fragment>
    <!-- Start Menu shortcut and ARP registration key path. -->
    <Component Id="ApplicationShortcuts"
               Directory="ProgramMenuDir"
               Guid="*">
      <Shortcut
          Id="LumenStartMenuShortcut"
          Name="Lumen"
          Description="Universal search for Windows"
          Target="[INSTALLFOLDER]Lumen.exe"
          WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
      <RegistryValue
          Root="HKCU"
          Key="Software\Lumen"
          Name="Installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <!-- Remove the installation directory after harvested files are removed. -->
    <Component Id="InstallFolderCleanup"
               Directory="INSTALLFOLDER"
               Guid="*">
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      <RegistryValue
          Root="HKCU"
          Key="Software\Lumen"
          Name="InstallFolderCleanup"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
